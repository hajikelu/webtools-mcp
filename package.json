{
  "name": "webtools-mcp",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "deploy": "cf deploy",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "pnpm peers check && pnpm run fmt:check && pnpm run typecheck && pnpm test",
    "test": "node --test",
    "typecheck": "cf workers types && tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.32.0",
    "jose": "^6.2.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.8",
    "@types/node": "^26.6.6",
    "cf": "1.0.0-beta.26",
    "oxfmt": "0.75.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "error"
    }
  }
}
